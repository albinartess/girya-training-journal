NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/girya.sqlite
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LOGIN_CODE_SECRET=
SESSION_SECRET=
# production requires HTTPS and a persistent /data volume, one replica.
# Set to 1 ONLY behind a proxy that replaces X-Forwarded-For and accepts no direct traffic.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# false + requireTLS enforces STARTTLS; no TLS bypass.
# For local Mailpit only (must remain false in production):
SMTP_LOCAL_TEST=false
