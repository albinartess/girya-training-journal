{
  "name": "girya-training-journal",
  "version": "0.3.0",
  "private": true,
  "engines": { "node": "24.14.0", "npm": "11.9.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.cjs",
    "migrate": "node --env-file-if-exists=.env server/migrate.cjs",
    "build": "node server/check.cjs",
    "test:ci": "node --test backup.test.cjs identity.test.cjs server/*.test.cjs",
    "backup:db": "node --env-file-if-exists=.env server/backup.cjs"
  },
  "dependencies": { "nodemailer": "10.6.0" }
}
